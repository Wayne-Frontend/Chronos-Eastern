<navigation-bar title="找日子" back="{{false}}" color="#24211E" background="#F7F3EA"></navigation-bar>

<view class="page-shell page-content find-date-page">
  <text class="page-hint">选择事项和日期范围，看看哪些日子更适合作为参考</text>

  <view class="section-card block">
    <text class="block__title">选择事项</text>
    <view class="event-grid">
      <view
        wx:for="{{view.eventOptions}}"
        wx:key="id"
        class="event-chip {{item.id === view.selectedEventId ? 'event-chip--active' : ''}} {{item.disabled ? 'event-chip--disabled' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSelectEvent"
        aria-role="button"
        aria-label="{{item.displayName}}{{item.disabled ? '（' + item.statusNote + '）' : ''}}"
      >
        <text class="event-chip__name">{{item.displayName}}</text>
        <text wx:if="{{item.badgeText}}" class="event-chip__note">{{item.badgeText}}</text>
      </view>
    </view>
  </view>

  <view class="section-card block">
    <text class="block__title">日期范围</text>
    <view class="range-row">
      <picker
        mode="date"
        value="{{view.startDate}}"
        start="{{view.pickerStart}}"
        end="2100-12-31"
        bindchange="onStartChange"
      >
        <view class="range-field" aria-role="button" aria-label="选择开始日期">
          <text class="range-field__label">开始</text>
          <text class="range-field__value">{{view.startDate}}</text>
        </view>
      </picker>
      <text class="range-sep">至</text>
      <picker
        mode="date"
        value="{{view.endDate}}"
        start="{{view.pickerStart}}"
        end="2100-12-31"
        bindchange="onEndChange"
      >
        <view class="range-field" aria-role="button" aria-label="选择结束日期">
          <text class="range-field__label">结束</text>
          <text class="range-field__value">{{view.endDate}}</text>
        </view>
      </picker>
    </view>
    <text class="range-hint">最早为今天，最长 {{view.maxRangeDays}} 天</text>

    <!-- 内联宽度是对微信 <button> 默认尺寸行为的兜底覆盖，见 find-date.scss 的 .query-button -->
    <button
      class="primary-button query-button"
      style="width: 100%;"
      disabled="{{!view.canQuery || view.status === 'running'}}"
      bindtap="onQuery"
      hover-class="button-pressed"
    >
      开始查找
    </button>
    <text wx:if="{{view.progressText}}" class="progress-text">{{view.progressText}}</text>
    <text wx:if="{{view.expiredNotice}}" class="expired-text">{{view.expiredNotice}}</text>
  </view>

  <view wx:if="{{view.noticeText}}" class="notice-card notice-card--{{view.noticeTone}}">
    <text>{{view.noticeText}}</text>
  </view>

  <!-- 条件行与汇总行只要算出来了就要显示：status 为 empty 时同样有核对总数与冲突计数，
       原先按 status 挡，会让 0 个通过的范围内所有统计凭空消失。 -->
  <view wx:if="{{view.summaryText}}" class="section-card block">
    <text class="condition-text">{{view.conditionText}}</text>
    <text class="summary-text">{{view.summaryText}}</text>
  </view>

  <view wx:if="{{view.status === 'ok' && view.results.length > 0}}" class="result-list">
    <view
      wx:for="{{view.results}}"
      wx:key="dateKey"
      class="section-card result-card"
      data-date-key="{{item.dateKey}}"
      bindtap="onOpenDetail"
      hover-class="result-card--pressed"
      aria-role="button"
      aria-label="查看 {{item.dateKey}} 详情"
    >
      <view class="result-head">
        <text class="result-date">{{item.dateText}}</text>
        <text class="result-weekday">{{item.weekdayText}}</text>
        <text wx:if="{{item.isFavorite}}" class="result-favorite">★ 已收藏</text>
      </view>
      <text class="result-meta">{{item.lunarText}}{{item.tagText ? ' · ' + item.tagText : ''}}</text>
      <text wx:if="{{item.moreText}}" class="result-more">{{item.moreText}}</text>
    </view>
  </view>

  <view wx:if="{{view.conflictCards.length > 0}}" class="conflict-card">
    <text class="conflict-card__title">{{view.conflictCards.length}} 天的传统说法不一致</text>
    <text class="conflict-card__hint">
      这些日期没有明确方向，因此没有放进候选结果。点开可以查看具体原因。
    </text>
    <view class="conflict-list">
      <view
        wx:for="{{view.conflictCards}}"
        wx:key="dateKey"
        class="conflict-item"
        data-date-key="{{item.dateKey}}"
        bindtap="onOpenDetail"
        hover-class="conflict-item--pressed"
        aria-role="button"
        aria-label="查看 {{item.dateKey}} 说法不一致的原因"
      >
        <text class="conflict-item__date">{{item.dateText}}</text>
        <text class="conflict-item__weekday">{{item.weekdayText}}</text>
      </view>
    </view>
  </view>

  <text wx:if="{{view.disclaimerText}}" class="disclaimer-text">{{view.disclaimerText}}</text>
</view>
