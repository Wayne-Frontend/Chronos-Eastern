<navigation-bar title="日期详情" color="#24211E" background="#F7F3EA"></navigation-bar>

<view class="page-shell page-content detail-page">
  <view class="detail-date section-card">
    <text class="detail-date__label">{{view.dateLabel}}</text>
    <text class="detail-date__value">{{view.dateKey || '日期参数无效'}}</text>
    <text wx:if="{{view.weekdayText}}" class="detail-date__meta">
      {{view.weekdayText}}{{view.lunarText ? ' · ' + view.lunarText : ''}}
    </text>
  </view>

  <view wx:if="{{view.noticeText}}" class="detail-notice" aria-role="note">
    <text>{{view.noticeText}}</text>
  </view>

  <view wx:if="{{view.status === 'ok'}}" class="detail-facts section-card">
    <text class="detail-facts__title">干支与节气</text>
    <view wx:for="{{view.ganzhiItems}}" wx:key="label" class="detail-row">
      <text class="detail-row__label">{{item.label}}</text>
      <text class="detail-row__value">{{item.value}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-row__label">节气</text>
      <text class="detail-row__value">{{view.todaySolarTermText}}</text>
    </view>
    <view wx:if="{{view.nextSolarTermText}}" class="detail-row">
      <text class="detail-row__label">下一个节气</text>
      <text class="detail-row__value">{{view.nextSolarTermText}}</text>
    </view>
    <text class="detail-caption">年、月干支在交节当天整日按新值计算（按日口径）。</text>
  </view>

  <view wx:if="{{view.status === 'ok'}}" class="detail-facts section-card">
    <text class="detail-facts__title">节日</text>
    <view wx:for="{{view.festivalItems}}" wx:key="id" class="detail-row">
      <text class="detail-row__label">{{item.categoryLabel}}</text>
      <text class="detail-row__value">{{item.name}}</text>
    </view>
    <text wx:if="{{view.festivalItems.length === 0}}" class="detail-caption">无已收录节日</text>
  </view>

  <view class="detail-block section-card">
    <empty-state
      title="本日暂无已完成校勘的传统规则"
      description="宜忌只来自带来源并通过测试的规则包，不以第三方历法库结果替代。"
    ></empty-state>
  </view>

  <view wx:if="{{view.status === 'ok'}}" class="detail-action">
    <button
      class="{{view.isFavorite ? 'primary-button' : 'secondary-button'}} detail-action__button detail-favorite"
      disabled="{{view.favoriteStatus !== 'ok'}}"
      bindtap="toggleFavorite"
      hover-class="button-pressed"
    >
      <text class="detail-favorite__icon">{{view.isFavorite ? '★' : '☆'}}</text>
      <text>{{view.isFavorite ? '已收藏' : '收藏'}}</text>
    </button>
  </view>

  <text wx:if="{{view.favoriteNotice}}" class="detail-favorite__notice">
    {{view.favoriteNotice}}
  </text>

  <view wx:if="{{view.status !== 'ok'}}" class="detail-action">
    <button
      class="secondary-button detail-action__button"
      bindtap="goToday"
      hover-class="button-pressed"
    >
      返回今天
    </button>
  </view>
</view>
