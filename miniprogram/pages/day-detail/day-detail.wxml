<navigation-bar title="日期详情" color="#24211E" background="#F7F3EA"></navigation-bar>

<view class="page-shell page-content detail-page">
  <view class="detail-date section-card">
    <text class="detail-date__label">{{view.dateLabel}}</text>
    <text class="detail-date__value">{{view.dateKey || '日期参数无效'}}</text>
    <text wx:if="{{view.weekdayText}}" class="detail-date__meta">
      {{view.weekdayText}}{{view.lunarText ? ' · ' + view.lunarText : ''}}
    </text>
  </view>

  <view wx:if="{{view.noticeText}}" class="detail-notice" aria-role="note">
    <text>{{view.noticeText}}</text>
  </view>

  <view wx:if="{{view.status === 'ok'}}" class="detail-facts section-card">
    <text class="detail-facts__title">干支与节气</text>
    <view wx:for="{{view.ganzhiItems}}" wx:key="label" class="detail-row">
      <text class="detail-row__label">{{item.label}}</text>
      <text class="detail-row__value">{{item.value}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-row__label">节气</text>
      <text class="detail-row__value">{{view.todaySolarTermText}}</text>
    </view>
    <view wx:if="{{view.nextSolarTermText}}" class="detail-row">
      <text class="detail-row__label">下一个节气</text>
      <text class="detail-row__value">{{view.nextSolarTermText}}</text>
    </view>
    <text class="detail-caption">年、月干支在交节当天整日按新值计算。</text>
  </view>

  <view wx:if="{{view.status === 'ok'}}" class="detail-facts section-card">
    <text class="detail-facts__title">节日</text>
    <view wx:for="{{view.festivalItems}}" wx:key="id" class="detail-row">
      <text class="detail-row__label">{{item.categoryLabel}}</text>
      <text class="detail-row__value">{{item.name}}</text>
    </view>
    <text wx:if="{{view.festivalItems.length === 0}}" class="detail-caption">无已收录节日</text>
  </view>

  <view wx:if="{{view.ruleSections.length === 0}}" class="detail-block section-card">
    <empty-state
      title="今天暂无传统择日建议"
      description="从“找日子”或首页的当天参考进入，可以查看对应事项的结果。"
    ></empty-state>
  </view>

  <!-- 逐事项一张卡：首页的今日宜忌可能同时给出几个事项的结论，只讲其中一个会让用户对不上账。 -->
  <view
    wx:for="{{view.ruleSections}}"
    wx:for-item="section"
    wx:for-index="sectionIndex"
    wx:key="eventTypeId"
    class="detail-rules section-card"
  >
    <text class="detail-rules__eyebrow">{{section.eventName}}参考</text>
    <text class="detail-rules__title">{{section.title}}</text>
    <text class="detail-rules__description">{{section.description}}</text>
    <text wx:if="{{section.suggestion}}" class="detail-rules__suggestion">{{section.suggestion}}</text>
    <text wx:if="{{section.noticeText}}" class="detail-rules__notice">{{section.noticeText}}</text>

    <text wx:if="{{section.coverageNoticeText}}" class="detail-rules__coverage-notice">
      {{section.coverageNoticeText}}
    </text>
    <text wx:if="{{section.coverageText}}" class="detail-rules__coverage-text">
      {{section.coverageText}}
    </text>

    <text wx:if="{{section.rules.length > 0}}" class="detail-rules__reason-title">为什么这样说</text>

    <view wx:for="{{section.rules}}" wx:key="id" class="detail-rule">
      <view class="detail-rule__head">
        <view class="detail-rule__badge detail-rule__badge--{{item.effectClass}}">
          {{item.badgeText}}
        </view>
        <view class="detail-rule__copy">
          <text class="detail-rule__title">{{item.title}}</text>
          <text class="detail-rule__summary">{{item.summary}}</text>
        </view>
      </view>
      <view
        class="detail-rule__source-toggle"
        data-section-index="{{sectionIndex}}"
        data-index="{{index}}"
        bindtap="toggleRuleSource"
        hover-class="detail-rule__source-toggle--pressed"
        aria-role="button"
        aria-label="{{item.sourceExpanded ? '收起传统说法与出处' : '了解传统说法与出处'}}"
        aria-expanded="{{item.sourceExpanded}}"
      >
        <image
          class="detail-rule__source-icon"
          src="{{item.sourceExpanded ? '/assets/icons/chevron-up-blue.svg' : '/assets/icons/chevron-down-blue.svg'}}"
          mode="aspectFit"
          aria-hidden="true"
        ></image>
        <text class="detail-rule__source-toggle-label">{{item.sourceExpanded ? '收起传统说法与出处' : '了解传统说法与出处'}}</text>
      </view>
      <view wx:if="{{item.sourceExpanded}}" class="detail-rule__source">
        <text class="detail-rule__source-label">传统说法</text>
        <text class="detail-rule__meta">{{item.explanation}}</text>
        <text class="detail-rule__source-label">原文出处</text>
        <text class="detail-rule__meta">{{item.locator}}</text>
        <text wx:if="{{item.sourceText}}" class="detail-rule__meta">来源：{{item.sourceText}}</text>
        <block wx:if="{{item.limitations.length > 0}}">
          <text class="detail-rule__source-label">适用范围与限制</text>
          <text
            wx:for="{{item.limitations}}"
            wx:for-item="limitation"
            wx:key="*this"
            class="detail-rule__meta"
          >{{limitation}}</text>
        </block>
      </view>
    </view>

    <text class="detail-rules__culture-note">传统文化参考，请结合现实安排与实际条件决定。</text>
  </view>

  <view wx:if="{{view.status === 'ok'}}" class="detail-action">
    <button
      class="{{view.isFavorite ? 'primary-button' : 'secondary-button'}} detail-action__button detail-favorite"
      disabled="{{view.favoriteStatus !== 'ok'}}"
      bindtap="toggleFavorite"
      hover-class="button-pressed"
    >
      <text class="detail-favorite__icon">{{view.isFavorite ? '★' : '☆'}}</text>
      <text>{{view.isFavorite ? '已收藏' : '收藏'}}</text>
    </button>
  </view>

  <text wx:if="{{view.favoriteNotice}}" class="detail-favorite__notice">
    {{view.favoriteNotice}}
  </text>

  <view wx:if="{{view.status !== 'ok'}}" class="detail-action">
    <button
      class="secondary-button detail-action__button"
      bindtap="goToday"
      hover-class="button-pressed"
    >
      返回今天
    </button>
  </view>
</view>
