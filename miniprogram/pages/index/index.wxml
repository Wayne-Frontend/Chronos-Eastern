<navigation-bar title="" back="{{false}}" color="#24211E" background="#F7F3EA"></navigation-bar>

<scroll-view class="page-shell home-scroll" scroll-y type="list">
  <view class="home-page">
    <view class="brand-row">
      <view class="brand-lockup">
        <text class="brand-name">岁月良辰</text>
        <text class="brand-seal">良辰</text>
      </view>
      <view class="brand-tagline">
        <text>以日常之时</text>
        <text>见生活之美</text>
        <view class="tagline-line"></view>
      </view>
    </view>

    <view wx:if="{{view.noticeText}}" class="home-notice" aria-role="note">
      <text>{{view.noticeText}}</text>
    </view>

    <view
      class="date-hero"
      bindtap="openDetail"
      hover-class="date-hero--pressed"
      aria-role="button"
      aria-label="查看日期详情"
    >
      <view class="date-meta">
        <text class="date-year">{{view.yearText}}</text>
        <view class="date-divider"></view>
        <text class="date-weekday">{{view.weekdayText}}</text>
      </view>
      <view class="date-display">
        <text class="date-number date-number--accent">{{view.monthText}}</text>
        <text class="date-unit">月</text>
        <text class="date-number date-number--accent">{{view.dayText}}</text>
        <text class="date-unit">日</text>
      </view>
      <text wx:if="{{view.lunarText}}" class="date-secondary">{{view.lunarText}}</text>
      <view wx:if="{{view.ganzhiItems.length > 0}}" class="ganzhi-row">
        <view wx:for="{{view.ganzhiItems}}" wx:key="label" class="ganzhi-chip">
          <text class="ganzhi-chip__label">{{item.label}}</text>
          <text class="ganzhi-chip__value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{view.status === 'error'}}" class="retry-row">
      <button
        class="secondary-button retry-button"
        bindtap="recalculate"
        hover-class="button-pressed"
      >
        重新计算
      </button>
    </view>

    <view class="info-block">
      <text class="info-block__label">节气</text>
      <view class="info-block__divider"></view>
      <view class="info-block__copy">
        <text class="info-block__title">{{view.solarTermTitle}}</text>
        <text class="info-block__description">{{view.solarTermDescription}}</text>
      </view>
    </view>

    <view wx:if="{{view.festivalTitle}}" class="info-block">
      <text class="info-block__label">节日</text>
      <view class="info-block__divider"></view>
      <view class="info-block__copy">
        <text class="info-block__title">{{view.festivalTitle}}</text>
        <text wx:if="{{view.festivalDescription}}" class="info-block__description">{{view.festivalDescription}}</text>
      </view>
    </view>

    <view wx:if="{{view.almanacRows.length > 0}}" class="rule-section">
      <view class="section-heading">
        <text class="section-title">今日宜忌</text>
        <button class="text-action" bindtap="openAlmanac" hover-class="text-action--pressed">
          查看详情 ›
        </button>
      </view>

      <view
        wx:for="{{view.almanacRows}}"
        wx:key="id"
        class="rule-row {{index === view.almanacRows.length - 1 ? 'rule-row--last' : ''}}"
      >
        <view class="rule-badge rule-badge--{{item.badgeClass}}">
          {{item.badge}}
        </view>
        <view class="rule-copy">
          <text class="rule-event-text">{{item.eventText}}</text>
          <text class="rule-reason-text">{{item.reasonText}}</text>
        </view>
      </view>
    </view>

    <view class="action-row">
      <button
        class="primary-button home-action"
        bindtap="openFindDate"
        hover-class="button-pressed"
      >
        找日子 <text class="action-arrow">›</text>
      </button>
      <button
        class="secondary-button home-action"
        bindtap="openCalendar"
        hover-class="button-pressed"
      >
        看日历 <text class="action-arrow">›</text>
      </button>
    </view>

    <view class="disclaimer-row">
      <view class="disclaimer-line"></view>
      <text>传统文化参考，请结合实际安排</text>
      <view class="disclaimer-line"></view>
    </view>
  </view>
</scroll-view>
