{
  "name": "chronos-eastern",
  "version": "1.0.0",
  "private": true,
  "description": "岁月良辰微信小程序",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint \"miniprogram/**/*.ts\" \"tests/**/*.ts\"",
    "lint:styles": "stylelint \"miniprogram/**/*.scss\"",
    "test": "vitest run",
    "format": "prettier --write \"miniprogram/**/*.{ts,scss,json}\" \"tests/**/*.ts\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"miniprogram/**/*.{ts,scss,json}\" \"tests/**/*.ts\" \"*.{json,mjs}\"",
    "check": "npm run typecheck && npm run lint && npm run lint:styles && npm run test && npm run format:check"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "lunar-javascript": "1.7.7"
  }
}
